<?xml version="1.0" ?>

<launch>
  <!-- rosbridge server -->
  <group ns="auto_dem">
     <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch" />
  </group>

  <!-- fr3 robot -->
  <node name="dielectrometer_manip" pkg="auto_dem" type="dielectrometer-manip-node.l" />

</launch>
